# Copy to .env and fill in. Never commit the real .env (already gitignored).
ANTHROPIC_API_KEY=

# Provider selection. Use mock for offline, deterministic runs with no API calls.
LLM_PROVIDER=anthropic

# Optional SQLite path override, useful for isolated/test runs.
# CROSS_AGENT_MEMORY_DB_PATH=/tmp/cross-agent-memory.sqlite

# Optional — defaults to claude-opus-5. Only override if you deliberately
# want a cheaper/faster model for a large batch run.
# CLAUDE_MODEL=claude-sonnet-5

# Test-mode keys only — used for the live payment-link demo, never called during
# agents:baseline/agents:memory.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
