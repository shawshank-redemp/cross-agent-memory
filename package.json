{
  "name": "cross-agent-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Shared customer memory layer for Razorpay point-agents (Cart Abandonment, Subscription Recovery, Dispute Responder) — Razorpay AI Buildathon Track 03.",
  "type": "module",
  "scripts": {
    "generate:data": "tsx src/data/index.ts",
    "validate:data": "sh scripts/runIsolated.sh tsx scripts/validateGeneratedData.ts",
    "estimate:cost": "tsx scripts/estimateRunCost.ts",
    "load:data": "tsx src/db/load.ts",
    "agents:baseline": "tsx --env-file-if-exists=.env src/agents/runBaseline.ts",
    "agents:memory": "tsx --env-file-if-exists=.env src/agents/runMemory.ts",
    "smoke:gemini": "CROSS_AGENT_MEMORY_DB_PATH=data/smoke/smoke.sqlite LLM_PROVIDER=gemini tsx --env-file-if-exists=.env scripts/smokeProvider.ts gemini",
    "smoke:ollama": "CROSS_AGENT_MEMORY_DB_PATH=data/smoke/smoke.sqlite LLM_PROVIDER=ollama tsx --env-file-if-exists=.env scripts/smokeProvider.ts ollama",
    "analyze:compare": "sh scripts/runIsolated.sh tsx src/analysis/compareRuns.ts",
    "analyze:metrics": "sh scripts/runIsolated.sh tsx src/analysis/analyzeMetrics.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && npm test",
    "test": "tsx --test tests/*.test.ts",
    "analyze:escalation": "sh scripts/runIsolated.sh tsx src/analysis/escalationSensitivity.ts",
    "verify:schema": "sh scripts/runIsolated.sh tsx scripts/verifySchema.ts",
    "measure:churn": "sh scripts/runIsolated.sh tsx scripts/measureChurnSignal.ts",
    "verify:prompts": "sh scripts/runIsolated.sh tsx scripts/verifyPromptInvariants.ts",
    "verify:fieldorder": "sh scripts/runIsolated.sh tsx --env-file-if-exists=.env scripts/verifyFieldOrder.ts",
    "policy:version": "tsx scripts/printPolicyVersion.ts",
    "poc:agent": "LLM_PROVIDER=ollama tsx --env-file-if-exists=.env poc/run.ts",
    "agents:agentic": "LLM_PROVIDER=ollama tsx --env-file-if-exists=.env src/agentic/run.ts",
    "analyze:arms": "sh scripts/runIsolated.sh tsx src/analysis/threeArmReport.ts",
    "agents:compare40": "sh scripts/compare40.sh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^3.4.0",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/ollama": "1.3.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
