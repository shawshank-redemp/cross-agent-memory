{
  "name": "cross-agent-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Shared customer memory layer for Razorpay point-agents (Cart Abandonment, Subscription Recovery, Dispute Responder) — Razorpay AI Buildathon Track 03.",
  "type": "module",
  "scripts": {
    "generate:data": "tsx src/data/index.ts",
    "load:data": "tsx src/db/load.ts",
    "agents:baseline": "tsx --env-file-if-exists=.env src/agents/runBaseline.ts",
    "agents:memory": "tsx --env-file-if-exists=.env src/agents/runMemory.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  }
}
